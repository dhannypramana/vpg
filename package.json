{
    "name": "vpg",
    "type": "module",
    "version": "1.0.0",
    "private": true,
    "description": "Vue Playground",
    "author": {
        "name": "Dan",
        "email": "dhanny.pramana@gmail.com",
        "url": "https://danwsaps.is-a-dev"
    },
    "keywords": [
        "Vue",
        "Playground"
    ],
    "engines": {
        "node": ">=22.12.0 <25"
