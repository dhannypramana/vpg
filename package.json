        "@vitejs/plugin-vue": "^6.0.3",
        "@vue/tsconfig": "^0.8.1",
        "eslint": "^9.39.2",
        "eslint-plugin-format": "^1.3.1",
        "npm-run-all2": "^8.0.4",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-vue-devtools": "^8.0.5",
        "vue-tsc": "^3.2.4"
